[Unit]
Description=Ravenfantom Killswitch Tor (nftables)
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/ravenfantom/nftables-killswitch.conf
ExecStart=/usr/sbin/nft -f /etc/ravenfantom/nftables-dns.conf
ExecStop=/usr/sbin/nft flush ruleset

[Install]
WantedBy=multi-user.target
